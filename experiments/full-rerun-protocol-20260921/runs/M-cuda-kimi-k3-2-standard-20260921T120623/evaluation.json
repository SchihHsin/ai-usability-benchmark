            "sha256": "e425d9eb45d52f3b1d083a6fc0b32ee54b4328b4c8262ebad6d33f42621abccc",
            "start": 1214,
            "end": 1351,
            "quote": "context.setOptimizationProfileAsync(0, stream);   // stream 必须与后续 enqueueV3 相同\n     context.setInputShape(\"foo\", Dims{3, {3, 150, 250}});",
            "json_escaped": false
          },
