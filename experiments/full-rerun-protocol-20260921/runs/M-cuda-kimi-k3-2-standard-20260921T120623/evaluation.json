            "start": 807,
            "end": 879,
            "quote": "They also specify the dimensions for which the auto-tuner will optimize.",
            "json_escaped": false
          },
          {
            "id": "ev-16",
            "event_id": "WebFetch_6_e4572cd8.result",
            "field": "response",
            "sha256": "8dfe5f1fca7db71a049fabc8b814924c26aa6a3a27e788253cd5ae2453343bb3",
            "start": 1881,
            "end": 1900,
            "quote": "- **`--maxShapes`**",
