          },
          {
            "id": "ev-19",
            "event_id": "WebFetch_1_da457e0b.result",
            "field": "response",
            "sha256": "21525194e67e1bf36e8b007b691b82b7bf942042df10e7b92e14c92b847b0729",
            "start": 929,
            "end": 974,
            "quote": "context.set_input_shape(\"foo\", (3, 150, 250))",
            "json_escaped": false
          },
          {
            "id": "ev-20",
            "event_id": "run-end",
            "field": "answer",
            "sha256": "e425d9eb45d52f3b1d083a6fc0b32ee54b4328b4c8262ebad6d33f42621abccc",
            "start": 3752,
            "end": 3892,
            "quote": "API `setInputShape`/`enqueueV3`/`setOptimizationProfileAsync` 为 10.x 现行接口；8.5+ 已有 execution/shape tensor 区分弱化。具体发行号（如 10.x.y）本页未给出，未核实确切小版本。",
            "json_escaped": false
          },
          {
            "id": "ev-21",
            "event_id": "run-end",
            "field": "answer",
            "sha256": "e425d9eb45d52f3b1d083a6fc0b32ee54b4328b4c8262ebad6d33f42621abccc",
            "start": 2437,
            "end": 2639,
            "quote": "trtexec --onnx=model.onnx \\\n  --minShapes=input0:1x3x224x224 \\\n  --optShapes=input0:8x3x640x640 \\\n  --maxShapes=input0:16x3x1280x1280 \\\n  --shapes=input0:4x3x640x640 \\\n  --saveEngine=model.engine --fp16",
            "json_escaped": false
          },
          {
            "id": "ev-22",
