            "start": 497,
            "end": 674,
            "quote": "atc --model=model.onnx --framework=5 --output=model_dyn \\\n    --soc_version=Ascend910B \\\n    --input_shape=\"data:-1,3,416,416;img_info:-1,4\" \\\n    --dynamic_batch_size=\"1,2,4,8\"",
