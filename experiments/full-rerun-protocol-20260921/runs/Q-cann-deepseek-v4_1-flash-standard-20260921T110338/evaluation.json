            "start": 4342,
            "end": 4404,
            "quote": "os.environ['PYTORCH_NPU_ALLOC_CONF'] = 'max_split_size_mb:128'",
            "json_escaped": false
          },
          {
            "id": "ev-15",
            "event_id": "call_00_yiOt1fQylCUs5Q9ojrMJ9733.result",
            "field": "response",
            "sha256": "e9884d83168833ef7d355338f32240fac0ada208d6d7e59100abf42eb439f31e",
            "start": 6306,
            "end": 6359,
            "quote": "频繁OOM但显存未满**显存碎片化设置 `ASCEND_RT_MEMORY_REUSE=1` / 重启进程",
            "json_escaped": false
          },
          {
            "id": "ev-16",
