          },
          {
            "id": "ev-20",
            "event_id": "run-end",
            "field": "answer",
            "sha256": "4c74327b944de2780d0d8eafa8bfba4d9f88996a2a2f89b0f89eee634abdfb3c",
            "start": 7962,
            "end": 8041,
            "quote": "梯度检查点在昇腾侧的专门版本要求 —— 未找到官方 Ascend 文档单列，本文按 PyTorch 标准接口给出，**Ascend 适配的额外要求未核实**。",
            "json_escaped": false
          },
          {
            "id": "ev-21",
            "event_id": "run-end",
            "field": "answer",
            "sha256": "4c74327b944de2780d0d8eafa8bfba4d9f88996a2a2f89b0f89eee634abdfb3c",
            "start": 4473,
            "end": 4556,
            "quote": "export PYTORCH_NPU_ALLOC_CONF=max_split_size_mb:32,garbage_collection_threshold:0.6",
