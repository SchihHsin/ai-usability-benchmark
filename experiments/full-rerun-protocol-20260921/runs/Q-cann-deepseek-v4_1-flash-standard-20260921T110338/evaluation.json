            "field": "answer",
            "sha256": "4c74327b944de2780d0d8eafa8bfba4d9f88996a2a2f89b0f89eee634abdfb3c",
            "start": 6898,
            "end": 6963,
            "quote": "`per_process_memory_fraction`：TorchNPU ≥26.1.0 且 PyTorch ≥2.10.0。",
