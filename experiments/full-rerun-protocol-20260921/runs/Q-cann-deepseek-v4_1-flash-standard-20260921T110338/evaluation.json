            "sha256": "2cbac10ce7dd9650263f31e3bd84902bd692c2e025c8917ade48f3152f399d87",
            "start": 1158,
            "end": 1241,
            "quote": "Activation checkpointing is a technique that **trades compute for memory**（以计算换内存）。",
            "json_escaped": false
          },
          {
            "id": "ev-8",
            "event_id": "call_00_6tsy338QfeIuEhkv2vuw2304.result",
