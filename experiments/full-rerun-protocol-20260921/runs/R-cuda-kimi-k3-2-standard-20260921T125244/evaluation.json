            "start": 3311,
            "end": 3386,
            "quote": "`torch.autocast` | \"new in version 1.10\" | pytorch.org/docs/stable/amp.html",
            "json_escaped": false
          },
          {
            "id": "ev-33",
            "event_id": "run-end",
            "field": "answer",
            "sha256": "3c1b305d3bb3abb7f4db8c9a29c8048693fe60c9d0bff4ba20eca055eef07852",
